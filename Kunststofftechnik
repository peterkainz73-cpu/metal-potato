  --accent:#86b6e6; --accent-ink:#0f1720; --gold:#e1b552; --gold-soft:#2c2617;
  --ok:#62c48e; --ok-soft:#183026; --bad:#f2847a; --bad-soft:#3a1d1b; --sol:#ff8f84; color-scheme:dark}
*{box-sizing:border-box}
body{background:var(--bg);color:var(--ink);font-family:var(--f-body);font-size:17px;line-height:1.5;
  padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));padding-block:0 48px}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:10;background:var(--surface)}
.wrap{max-width:860px;margin:0 auto}
/* Kopf */
.top{padding-block:28px 18px;display:grid;gap:10px}
.eyebrow{font-family:var(--f-display);font-weight:600;letter-spacing:.08em;text-transform:uppercase;font-size:14px;color:var(--muted)}
h1{font-family:var(--f-display);font-weight:700;font-size:clamp(32px,6vw,46px);line-height:1.02;margin:0;text-wrap:balance}
.lead{margin:0;color:var(--muted);max-width:66ch}
.iso{display:flex;gap:3px;margin-top:4px}
.iso span{flex:1;height:22px;border-radius:3px;font:600 13px/22px var(--f-mono);text-align:center;color:#fff}
.iso .m{color:#1b1b1b}
nav.areas{display:flex;flex-wrap:wrap;gap:8px;margin-top:6px}
nav.areas a{font-family:var(--f-display);font-weight:600;font-size:17px;letter-spacing:.02em;text-decoration:none;color:var(--accent);
  border:1.5px solid var(--line);border-radius:999px;padding:4px 14px;background:var(--surface)}
nav.areas a.cur{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}
nav.areas a:focus-visible,.btn:focus-visible,.chipbtn:focus-visible{outline:3px solid var(--gold);outline-offset:2px}
/* Leiste */
.bar{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:var(--surface);border:1px solid var(--line);border-radius:var(--r);
  display:flex;flex-wrap:wrap;align-items:center;gap:10px 16px;padding:10px 14px;margin-bottom:18px}
.score{font-family:var(--f-mono);font-size:14px;font-variant-numeric:tabular-nums;color:var(--muted)}
.score b{color:var(--ink)}
.meter{flex:1 1 140px;height:8px;background:var(--soft);border-radius:999px;overflow:hidden;min-width:100px}
.meter i{display:block;height:100%;width:0;background:var(--ok);transition:width .3s}
.filters{display:flex;gap:6px}
.chipbtn{font:600 14px var(--f-body);border:1.5px solid var(--line);background:var(--surface);color:var(--ink);border-radius:999px;padding:3px 12px;cursor:pointer}
.chipbtn[aria-pressed="true"]{border-color:var(--accent);background:var(--accent);color:var(--accent-ink)}
.hint{font-size:15px;color:var(--muted);background:var(--surface);border:1px solid var(--line);border-left:4px solid var(--accent);border-radius:var(--r);padding:10px 14px;margin:0 0 18px}
/* Aufgaben */
.tasks{display:grid;gap:18px}
.task{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);min-width:0}
.task[data-level="B"]{border-top:4px solid var(--gold)}
.task[data-level="P"]{border-top:4px solid var(--accent)}
.task-head{display:flex;flex-wrap:wrap;align-items:baseline;gap:6px 12px;padding:14px 18px 4px}
.task-head h2{margin:0;font-family:var(--f-display);font-weight:700;font-size:24px;letter-spacing:.01em}
.typ{font-size:14px;color:var(--muted)}
.lvl{margin-left:auto;font:600 13px var(--f-body);letter-spacing:.06em;text-transform:uppercase;padding:2px 10px;border-radius:999px;border:1.5px solid}
.lvl b{letter-spacing:0;font-weight:400}
.lvl-p{color:var(--accent);border-color:var(--accent)}
.lvl-b{color:var(--gold);border-color:var(--gold);background:var(--gold-soft)}
.task-body{padding:6px 18px 8px;display:grid;gap:14px;min-width:0}
.q{max-width:72ch}
.q p{margin:0 0 6px}
.part{display:grid;gap:8px;min-width:0}
.code{font-family:var(--f-mono);font-weight:600;background:var(--soft);border:1px solid var(--line);border-radius:4px;padding:0 6px;white-space:nowrap}
figure.sheet{margin:4px 0;background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:10px;width:100%}
figure.sheet img{display:block;width:100%;height:auto}
textarea,input[type=text],select{font:inherit;font-size:16px;color:var(--ink);background:var(--soft);border:1.5px solid var(--line);border-radius:4px;padding:6px 8px;max-width:100%}
textarea{width:100%;resize:vertical}
textarea:focus,input:focus,select:focus{outline:none;border-color:var(--accent);background:var(--surface)}
.field{display:inline-flex;flex-direction:column;gap:2px;vertical-align:middle;max-width:100%}
.field.open{display:flex;width:100%}
.field.open input,.field.open textarea{width:100%}
td .field:not(.open) input,td .field select{width:100%}
td .field{display:flex}
.field.is-ok input,.field.is-ok select{border-color:var(--ok);background:var(--ok-soft)}
.field.is-bad input,.field.is-bad select{border-color:var(--bad);background:var(--bad-soft)}
.ans,.reveal{font-family:var(--f-body);font-size:14.5px;font-weight:600;color:var(--sol);line-height:1.35}
.ans::before{content:"→ "}
.gaptext{line-height:2.4;margin:0;max-width:75ch}
.gaptext .field{margin:0 2px}
.bank{display:flex;flex-wrap:wrap;gap:6px;align-items:center}
.bank-label{font:600 13px var(--f-body);text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin-right:4px}
.chip{font-size:14.5px;border:1px dashed var(--muted);border-radius:4px;padding:1px 8px}
ul.mc{list-style:none;margin:0;padding:0;display:grid;gap:6px}
ul.mc li{display:flex;gap:10px;align-items:flex-start;padding:7px 10px;border:1.5px solid var(--line);border-radius:4px}
ul.mc input{margin-top:4px;width:18px;height:18px;flex:none;accent-color:var(--accent)}
ul.mc li.is-ok{border-color:var(--ok);background:var(--ok-soft)}
ul.mc li.is-bad{border-color:var(--bad);background:var(--bad-soft)}
ul.mc li.should label::after{content:"  ✓ richtig";color:var(--sol);font-weight:700;font-size:14px}
.tbl{overflow-x:auto;max-width:100%}
table{border-collapse:collapse;width:100%;font-size:15.5px}
th,td{border:1px solid var(--line);padding:6px 8px;text-align:left;vertical-align:middle}
thead th{background:var(--soft);font-family:var(--f-display);font-weight:600;font-size:16px;letter-spacing:.02em}
td.c,th.c{text-align:center}
table.rf td.c{width:72px}
table.rf input{width:18px;height:18px;accent-color:var(--accent)}
table.rf tr.is-ok td{background:var(--ok-soft)}
table.rf tr.is-bad td{background:var(--bad-soft)}
table.rf td.should{box-shadow:inset 0 0 0 2px var(--sol)}
.numrow{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.unit{font-family:var(--f-mono);color:var(--muted)}
.solution{border-left:3px solid var(--sol);background:var(--soft);padding:8px 12px;border-radius:0 4px 4px 0;font-size:15.5px;max-width:75ch}
.solution p{margin:0 0 6px}.solution p:last-child{margin:0}
.solution ul{margin:4px 0;padding-left:20px}
.sol-label{display:block;font:600 12.5px var(--f-body);text-transform:uppercase;letter-spacing:.08em;color:var(--sol);margin-bottom:2px}
.task-foot{display:flex;flex-wrap:wrap;gap:8px;align-items:center;padding:10px 18px 16px}
.btn{font:600 15px var(--f-body);border-radius:4px;padding:6px 14px;border:1.5px solid var(--accent);background:var(--surface);color:var(--accent);cursor:pointer}
.btn.primary{background:var(--accent);color:var(--accent-ink)}
.btn.ghost{border-color:transparent;color:var(--muted)}
.btn:hover{filter:brightness(1.08)}
.result{font-family:var(--f-mono);font-size:14px;font-variant-numeric:tabular-nums}
.result.good{color:var(--ok)}.result.mid{color:var(--gold)}.result.low{color:var(--bad)}
.foot{margin-top:28px;font-size:14px;color:var(--muted)}
.mono{font-family:var(--f-mono)}
/* ISO-Schlüssel für Wendeschneidplatten */
.key{display:flex;flex-wrap:wrap;gap:4px;font-family:var(--f-mono)}
.key span{display:grid;place-items:center;min-width:42px;padding:4px 6px;border:1.5px solid var(--ink);border-radius:3px;font-weight:600;font-size:20px;background:var(--surface)}
.key span small{display:block;font-size:11px;font-weight:400;color:var(--muted)}
@media (max-width:560px){body{font-size:16px}.task-head,.task-body,.task-foot{padding-left:12px;padding-right:12px}.lvl{margin-left:0}}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
.symb{font-family:var(--f-mono);font-weight:600;font-size:18px}
.nb{white-space:nowrap}
.merke{border:1px solid var(--line);border-left:4px solid var(--gold);background:var(--gold-soft);border-radius:var(--r);padding:8px 12px;font-size:15.5px;max-width:75ch}
table.grid td:first-child{min-width:0}

figure.sheet figcaption{font-size:13px;color:var(--muted);margin-top:4px;text-align:center}
.komp{margin:0 0 18px;padding:10px 14px;background:var(--surface);border:1px solid var(--line);border-left:4px solid var(--ok);border-radius:var(--r);font-size:15.5px}
.komp ul{margin:4px 0 0;padding-left:20px}
.info{margin:0 0 18px}
.info summary{cursor:pointer;font-family:var(--f-display);font-weight:600;font-size:19px;color:var(--accent)}
.info .tbl{margin-top:8px}
.info .merke{margin:12px 0}
.info figure{margin:12px 0}
figure.sheet.small{max-width:460px}

</style>
