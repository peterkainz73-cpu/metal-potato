<script>

(function(){
  var KEY='maf-kt-04-v2';
  var store={};
  try{store=JSON.parse(localStorage.getItem(KEY)||'{}')||{};}catch(e){store={};}
  function save(){try{localStorage.setItem(KEY,JSON.stringify(store));}catch(e){}}
  function norm(s){return String(s||'').toLowerCase().replace(/ß/g,'ss').replace(/[\s\-–.,;:()\/"'„“]/g,'');}
  function num(s){var v=parseFloat(String(s).replace(',','.').replace(/[^\d.\-]/g,''));return isNaN(v)?null:v;}
  var tasks=[].slice.call(document.querySelectorAll('.task'));
  var results={};

  // Eingaben wiederherstellen und speichern
  [].slice.call(document.querySelectorAll('input,textarea,select')).forEach(function(el){
    if(!el.id||el.closest('.bar'))return;
    var v=store[el.id];
    if(v!==undefined){ if(el.type==='checkbox'||el.type==='radio') el.checked=!!v; else el.value=v; }
    el.addEventListener('change',function(){store[el.id]=(el.type==='checkbox'||el.type==='radio')?el.checked:el.value;
      if(el.type==='radio'){[].slice.call(document.getElementsByName(el.name)).forEach(function(o){store[o.id]=o.checked;});}
      save();});
    el.addEventListener('input',function(){if(el.type!=='checkbox'&&el.type!=='radio'){store[el.id]=el.value;save();}});
  });

  function items(card){return [].slice.call(card.querySelectorAll('[data-check]'));}
  function holder(el){return el.dataset.check==='mc'?el.closest('li'):(el.dataset.check==='rf'?el:el.closest('.field'));}
  function isRight(el){
    var t=el.dataset.check;
    if(t==='mc') return el.checked===(el.dataset.ok==='1');
    if(t==='rf'){var s=el.querySelector('input:checked');return !!s&&s.value===el.dataset.a;}
    if(t==='sel'){var al=el.dataset.alt?JSON.parse(el.dataset.alt):[el.dataset.a];return al.indexOf(el.value)>=0;}
    if(t==='grp') return !!(GM&&GM.get(el));
    if(t==='num'){var v=num(el.value);return v!==null&&Math.abs(v-parseFloat(el.dataset.v))<=parseFloat(el.dataset.tol);}
    if(t==='txt'){var a=JSON.parse(el.dataset.a),n=norm(el.value);return n!==''&&a.some(function(x){return norm(x)===n;});}
    return false;
  }
  var GM=null;
  // Austauschbare Lücken: jede Lösung der Gruppe darf in jeder Lücke stehen, aber nur einmal
  function grpEval(card){var m=new Map(),g={};
    items(card).forEach(function(el){if(el.dataset.check==='grp'){(g[el.dataset.grp]=g[el.dataset.grp]||[]).push(el);}});
    Object.keys(g).forEach(function(k){var used={},seen={};g[k].forEach(function(el){var set=JSON.parse(el.dataset.set),n=norm(el.value),hit=-1;
      if(n!==''&&!seen[n]){seen[n]=1;set.forEach(function(alts,i){if(hit<0&&!used[i]&&alts.some(function(x){return norm(x)===n;}))hit=i;});}
      if(hit>=0)used[hit]=1;m.set(el,hit>=0);});});
    return m;}
  function clearMarks(card){
    [].slice.call(card.querySelectorAll('.is-ok,.is-bad,.should')).forEach(function(e){e.classList.remove('is-ok','is-bad','should');});
    [].slice.call(card.querySelectorAll('.ans')).forEach(function(e){e.remove();});
  }
  function check(card){
    clearMarks(card);
    GM=grpEval(card);
    var it=items(card),ok=0;
    it.forEach(function(el){var r=isRight(el);if(r)ok++;holder(el).classList.add(r?'is-ok':'is-bad');});
    var res=card.querySelector('.result');
    res.textContent=ok+' von '+it.length+' richtig';
    res.className='result '+(ok===it.length?'good':(ok>=it.length/2?'mid':'low'));
    results[card.id]={ok:ok,total:it.length};
    update();
  }
  function solve(card){
    var open=card.dataset.open==='1';
    var btn=card.querySelector('.js-solve');
    [].slice.call(card.querySelectorAll('.solution,.reveal')).forEach(function(e){e.hidden=open;});
    if(open){ [].slice.call(card.querySelectorAll('.ans')).forEach(function(e){e.remove();});
      [].slice.call(card.querySelectorAll('.should')).forEach(function(e){e.classList.remove('should');}); }
    else items(card).forEach(function(el){
      var t=el.dataset.check;
      if(t==='mc'){ if(el.dataset.ok==='1') el.closest('li').classList.add('should'); }
      else if(t==='rf'){ var c=el.querySelector('input[value="'+el.dataset.a+'"]'); c.closest('td').classList.add('should'); }
      else { var s=document.createElement('span'); s.className='ans'; s.textContent=el.dataset.show; el.closest('.field').appendChild(s); }
    });
    card.dataset.open=open?'0':'1';
    btn.textContent=open?'Musterlösung zeigen':'Musterlösung ausblenden';
  }
  function reset(card){
    clearMarks(card);
    [].slice.call(card.querySelectorAll('input,textarea,select')).forEach(function(el){
      if(el.type==='checkbox'||el.type==='radio') el.checked=false; else el.value='';
      delete store[el.id];});
    save();
    if(card.dataset.open==='1') solve(card);
    var res=card.querySelector('.result');res.textContent='';res.className='result';
    delete results[card.id];update();
  }
  function update(){
    var p=0,m=0,d=0,c=0;
    tasks.forEach(function(t){var n=items(t).length;if(!n)return;c++;m+=n;if(results[t.id]){d++;p+=results[t.id].ok;}});
    document.getElementById('pts').textContent=p;document.getElementById('max').textContent=m;
    document.getElementById('done').textContent=d;document.getElementById('cnt').textContent=c;
    document.getElementById('meter').style.width=(m?Math.round(100*p/m):0)+'%';
  }
  tasks.forEach(function(card){
    if(!items(card).length){card.querySelector('.js-check').hidden=true;}
    card.querySelector('.js-check').addEventListener('click',function(){check(card);});
    card.querySelector('.js-solve').addEventListener('click',function(){solve(card);});
    card.querySelector('.js-reset').addEventListener('click',function(){reset(card);});
  });
  [].slice.call(document.querySelectorAll('.chipbtn')).forEach(function(b){
    b.addEventListener('click',function(){
      var f=b.dataset.f;
      [].slice.call(document.querySelectorAll('.chipbtn')).forEach(function(o){o.setAttribute('aria-pressed',o===b?'true':'false');});
      tasks.forEach(function(t){t.hidden=!(f==='all'||t.dataset.level===f);});
    });
  });
  var ra=document.getElementById('resetall'),armed=false;
  ra.addEventListener('click',function(){
    if(!armed){armed=true;ra.textContent='Wirklich alles löschen? Nochmal klicken';setTimeout(function(){armed=false;ra.textContent='Alle Eingaben löschen';},4000);return;}
    tasks.forEach(reset);store={};save();armed=false;ra.textContent='Alle Eingaben löschen';
  });
  update();
})();

</script>
</body>
